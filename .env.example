# TravelAlarm / Arrivo — Environment Configuration Example

# URL of the backend API (FastAPI)
# Local dev: http://localhost:8000
# Production: https://travel-destination-alarm.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# Optional: Google Maps JavaScript API Key
# If omitted or left blank, the app runs using Leaflet + OpenStreetMap CartoDB tiles
# with zero costs, high performance, and full offline routing fallback!
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
