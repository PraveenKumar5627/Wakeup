# TravelAlarm / Arrivo — Frontend Environment Configuration Example

# URL of the backend API (FastAPI)
# Local development: http://localhost:8000
# Production deployment: https://travel-destination-alarm.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# Optional: Google Maps JavaScript API Key
# If omitted or left empty, the application automatically uses Leaflet + OpenStreetMap
# with zero costs, full offline capability, and high performance.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
